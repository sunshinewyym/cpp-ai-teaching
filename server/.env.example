DEEPSEEK_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# MiMo（将 AI_PROVIDER 改为 mimo 后启用）
MIMO_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
MIMO_BASE_URL=https://token-plan-cn.xiaomimimo.com/v1
MIMO_MODEL=mimo-v2.5
PORT=3000

# Code debugging execution. Use runner in production Docker Compose; use local for controlled development.
CODE_RUNNER_MODE=runner
RUNNER_SOCKET_PATH=/run/cpp-runner/runner.sock
DEBUG_MAX_SOURCE_LENGTH=65536
DEBUG_MAX_INPUT_LENGTH=65536
DEBUG_MAX_SAMPLES=3
DEBUG_MAX_OUTPUT_BYTES=262144
DEBUG_COMPILE_TIMEOUT_MS=8000
DEBUG_RUN_TIMEOUT_MS=2000
DEBUG_RUNNER_TIMEOUT_MS=20000
DEBUG_VERIFY_CACHE_TTL_MS=60000
DEBUG_VERIFY_CACHE_MAX=100
DEBUG_REQUESTS_PER_MINUTE=30
DEBUG_AI_CONNECT_TIMEOUT_MS=30000
DEBUG_AI_TOTAL_TIMEOUT_MS=60000
DEBUG_AI_IDLE_TIMEOUT_MS=20000
DEBUG_AI_TIMEOUT_MS=60000
DEBUG_AI_MAX_TOKENS=1600
# 可为调试分析单独指定模型；留空时沿用 AI_MODEL/DEEPSEEK_MODEL。
DEBUG_AI_MODEL=
# DeepSeek 调试分析默认关闭深度推理，避免短提示耗尽输出预算；需要时可改为 enabled。
DEBUG_AI_THINKING=disabled

# 可选：使用其他 OpenAI 兼容模型服务时设置以下变量。
AI_PROVIDER=deepseek
AI_BASE_URL=https://api.deepseek.com
AI_MODEL=deepseek-chat
# AI_API_KEY 留空时继续读取 DEEPSEEK_API_KEY。
AI_API_KEY=

# Algorithm Coach
COACH_TIMEOUT_MS=90000
COACH_MODEL_RETRIES=1
COACH_MAX_ROUNDS=16

# JWT Secret (用于登录认证，部署时请修改为随机字符串)
JWT_SECRET=your-random-secret-key-here

# 数据存储目录（默认 ./data）
DATA_DIR=./data
